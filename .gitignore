# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated embeddings (72MB, rebuild with: npm run build:embeddings)
/apps/web/public/hadith-embeddings.bin
.cache/

# source hadith JSON (175MB, see README for download instructions)
/data/hadith-json

# --- iOS ---
# Generated by XcodeGen from apps/ios/project.yml — never commit
/apps/ios/*.xcodeproj
/apps/ios/DerivedData/
xcuserdata/
*.xcuserstate
.swiftpm/

# Offline artifacts are built by packages/pipeline, not committed (~170MB).
# vocab.txt is the deliberate exception: it's 256KB, it's fixed for the life of
# the model, and committing it means a fresh clone builds without needing a
# Convex deployment first.
/apps/ios/CheckTheChain/Resources/hadith.sqlite
/apps/ios/CheckTheChain/Resources/embeddings.bin
/apps/ios/CheckTheChain/Resources/embeddings.json
/apps/ios/CheckTheChain/Resources/MiniLM.mlpackage/

# --- pipeline ---
/packages/pipeline/out/
/packages/pipeline/coreml/.venv/

# Swift Package Manager build products
.build/

# Subagent-driven-development scratch: ledgers, briefs, review packages.
# The git history is the real record.
/.superpowers/

# Device build products (separate from the simulator DerivedData).
apps/ios/DerivedDataDevice/

# Simulator verification media produced by agent tooling during development.
apps/ios/artifacts/
