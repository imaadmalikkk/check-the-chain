{
  "name": "@check-the-chain/pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Builds the iOS app's offline artifacts (SQLite + embeddings + Core ML model) from the Convex corpus.",
  "scripts": {
    "export": "tsx src/export-convex.ts",
    "sqlite": "tsx src/build-sqlite.ts",
    "embeddings": "tsx src/build-embeddings.ts",
    "coreml": "coreml/run-convert.sh",
    "stage": "tsx src/stage-ios.ts",
    "build": "npm run export && npm run sqlite && npm run embeddings && npm run coreml && npm run stage",
    "capture-golden": "tsx src/capture-golden.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "better-sqlite3": "^12.2.0",
    "convex": "^1.32.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
